<?xml version="1.0"?>
<!-- ============================================================================
  包 go2w_description：Unitree Go2-W 官方 URDF 与 DAE 网格（ROS 2 包装）

  模型来源：
    https://github.com/unitreerobotics/unitree_ros
    robots/go2w_description
    commit 157ff950351e5f535e03c5d85a16b7d594b3dbcc

  官方包是 ROS 1/catkin；本包只保留 URDF 与 DAE，改成 ROS 2 ament_cmake。
  除 <robot name> 从 go2w_description 改为 go2w 外，几何/关节/网格未改。
============================================================================ -->
<package format="3">
  <name>go2w_description</name>
  <version>1.0.0</version>
  <description>Official Unitree Go2-W URDF and DAE meshes (ROS 2 wrapper, 12 leg + 4 wheel joints).</description>
  <maintainer email="iszhouxin@zju.edu.cn">SCAN-Planner maintainers</maintainer>
  <license>BSD</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>xacro</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <architecture_independent/>
  </export>
</package>
